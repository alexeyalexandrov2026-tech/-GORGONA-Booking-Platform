# Local development only. Copy to .env (git-ignored) and replace every value.
# Never put staging or production credentials in this file.

# Superuser of the local Docker PostgreSQL (infra/local/compose.yaml).
GBA_LOCAL_SUPERUSER_PASSWORD=change-me-local-superuser

# Superuser DSN: used only by `gba-db bootstrap` and by the integration-test fixture.
GBA_ADMIN_DATABASE_URL=postgresql://gba_superuser:change-me-local-superuser@127.0.0.1:55432/postgres
GBA_TEST_ADMIN_DSN=postgresql://gba_superuser:change-me-local-superuser@127.0.0.1:55432/postgres

# Roles created by `gba-db bootstrap`.
GBA_DATABASE_NAME=gorgona_booking
GBA_OWNER_ROLE=gba_owner
GBA_OWNER_PASSWORD=change-me-owner
GBA_APP_ROLE=gba_app
GBA_APP_PASSWORD=change-me-app

# Owner/migration credential: `gba-db migrate` only. Never given to the API.
GBA_MIGRATION_DATABASE_URL=postgresql://gba_owner:change-me-owner@127.0.0.1:55432/gorgona_booking

# Runtime credential: the only database credential the API process should receive.
GBA_DATABASE_URL=postgresql://gba_app:change-me-app@127.0.0.1:55432/gorgona_booking

GBA_ENV=local
GBA_HOLD_TTL_SECONDS=600
